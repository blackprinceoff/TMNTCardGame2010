<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.author.demo.tmntcardgame.controller.MenuController"
      alignment="CENTER" spacing="20"
      style="-fx-background-color: #2a4d3a;">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <Label text="БИТВА КАРТОК"
           style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: gold;"/>

    <VBox fx:id="menuBox" alignment="CENTER" spacing="15">
        <Label text="Кількість гравців:"
               style="-fx-font-size: 16px; -fx-text-fill: white;"/>
        <Spinner fx:id="playersSpinner" prefWidth="100"/>

        <Label text="Імена гравців:"
               style="-fx-font-size: 16px; -fx-text-fill: white;"/>
        <VBox fx:id="playerNamesBox" alignment="CENTER" spacing="10"/>

        <Button fx:id="startGameButton" text="Почати гру"
                onAction="#handleStartGame"
                prefWidth="200" prefHeight="40"
                style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Button fx:id="rulesButton" text="Правила"
                onAction="#handleShowRules"
                prefWidth="200" prefHeight="40"
                style="-fx-font-size: 16px;"/>

        <Button fx:id="exitButton" text="Вихід"
                onAction="#handleExit"
                prefWidth="200" prefHeight="40"
                style="-fx-font-size: 16px;"/>
    </VBox>
</VBox>
